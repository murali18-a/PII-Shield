# ──────────────────────────────────────────────
# PII-Shield .gitignore
# ──────────────────────────────────────────────

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
*.so

# ── Virtual environments ─────────────────────
.venv/
venv/
env/
ENV/

# ── Environment & secrets ────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── SQLite databases ─────────────────────────
*.db
*.sqlite
*.sqlite3

# ── IDE & editors ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── pytest / coverage ────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── mypy ─────────────────────────────────────
.mypy_cache/

# ── Node / Dashboard ────────────────────────
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
npm-debug.log*

# ── OS files ─────────────────────────────────
Desktop.ini
ehthumbs.db

# ── spaCy models (large, downloaded at setup) ─
models/
