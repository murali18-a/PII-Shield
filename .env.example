# ──────────────────────────────────────────────
# PII-Shield Environment Configuration
# Copy this file to .env and customise values.
# NEVER commit .env — it is in .gitignore.
# ──────────────────────────────────────────────

# ── Server ───────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=info

# ── CORS (comma-separated origins) ──────────
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:5173

# ── Presidio / spaCy ────────────────────────
SPACY_MODEL=en_core_web_lg
PRESIDIO_SCORE_THRESHOLD=0.5

# ── Session ──────────────────────────────────
SESSION_TTL_SECONDS=3600

# ── Audit database ──────────────────────────
AUDIT_DB_URL=sqlite:///./audit.db

# ── Policy ───────────────────────────────────
DEFAULT_POLICY_PROFILE=default
